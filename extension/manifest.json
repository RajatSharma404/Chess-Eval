{
  "manifest_version": 3,
  "name": "MasterMind Analyst",
  "version": "1.0",
  "description": "Redirects Chess.com and Lichess analysis to the MasterMind platform.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://*.chess.com/*",
    "*://*.lichess.org/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.chess.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.chess.com/*", "*://*.lichess.org/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Analyze in MasterMind"
  }
}
